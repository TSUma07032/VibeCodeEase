{
  "name": "vibecodeease",
  "displayName": "vibeCodeEase",
  "publisher": "tubas",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecodeease.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vibecodeease.switchMode",
        "title": "Switch vibeCodeEase Mode"
      },
      {
        "command": "vibecodeease.configureGeminiKey",
        "title": "vibeCodeEase: Configure Gemini API Key"
      },
      {
        "command": "vibecodeease.applyIntervention",
        "title": "vibeCodeEase: Apply Intervention"
      },
      {
        "command": "vibecodeease.openSideEditor",
        "title": "vibeCodeEase: Open AI Side Editor"
      }
    ],
    "configuration": {
      "title": "vibeCodeEase",
      "properties": {
        "vibecodeease.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Gemini API Key (Note: It is highly recommended to use the sidebar or command palette to store it securely in SecretStorage instead of this plain text setting.)"
        },
        "vibecodeease.llmProvider": {
          "type": "string",
          "enum": [
            "gemini",
            "vscode-lm"
          ],
          "default": "gemini",
          "description": "LLM Provider to use (gemini or vscode-lm)"
        },
        "vibecodeease.llmModel": {
          "type": "string",
          "enum": [
            "gemini-3.8-flash",
            "gemini-3.8-live",
            "gemini-3.8-live-extended-thinking",
            "gemini-3.8-flash-tts",
            "gemini-3.8-flash-lite-tts",
            "gemini-3.6-flash",
            "gemini-3.5-flash-lite",
            "gemini-3.1-flash-lite",
            "gemini-nano-banana-2.1",
            "gemini-3.1-flash-image",
            "gemini-3.1-flash-lite-image",
            "gemini-3-pro-image",
            "gemini-3.1-pro-preview",
            "gemini-3-flash-preview",
            "gemini-3.5-live-translate-preview",
            "gemini-3.1-flash-live-preview",
            "gemini-3.1-flash-tts-preview",
            "gemini-omni-1.1-flash",
            "gemini-3.5-transcribe",
            "gemini-3.5-transcribe-live",
            "gemini-2.5-flash",
            "gemini-2.5-flash-image",
            "gemini-2.5-flash-native-audio-preview-12-2025",
            "gemini-2.5-flash-preview-tts",
            "gemini-2.5-flash-lite"
          ],
          "default": "gemini-3.5-flash-lite",
          "description": "LLM Model to use (e.g. gemini-3.6-flash, gpt-4o)"
        },
        "vibecodeease.aiInterventionLevel": {
          "type": "string",
          "enum": [
            "Level 1 (Typo/Bug Fix)",
            "Level 2 (Refactoring)",
            "Level 3 (Architecture Optimization)"
          ],
          "default": "Level 2 (Refactoring)",
          "description": "AIによる推敲（介入）の積極性レベルを指定します"
        },
        "vibecodeease.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "ファイル保存時に自動でAIによるコード推敲を実行します",
          "deprecationMessage": "Use vibecodeease.llm.syncFrequency instead."
        },
        "vibecodeease.llm.syncFrequency": {
          "type": "string",
          "enum": [
            "manual",
            "onSave",
            "interval"
          ],
          "default": "onSave",
          "description": "LLM API communication frequency"
        },
        "vibecodeease.llm.syncIntervalSeconds": {
          "type": "number",
          "default": 10,
          "description": "Communication interval in seconds (5-3600)"
        }
      }
    }
  },
  "scripts": {
    "build:ui": "npm run build --prefix webview-ui",
    "watch:ui": "npm run build --prefix webview-ui -- -w",
    "build:all": "npm run compile && npm run build:ui",
    "watch:all": "npm-run-all -p watch:esbuild watch:ui",
    "watch": "npm run watch:all",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "npm run lint:biome && npm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint src",
    "lint:fix": "biome check --write . && eslint src --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:ui": "npm run test --prefix webview-ui",
    "test:e2e": "npm run test:e2e --prefix webview-ui",
    "test:e2e:headed": "npm run test:e2e:headed --prefix webview-ui",
    "test:all": "npm run test:ui && npm run test",
    "test:llm": "npm run compile-tests && vscode-test --run out/test/llmIntegration.test.js",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
