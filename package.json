{
  "name": "vibecodeease",
  "displayName": "vibeCodeEase",
  "publisher": "tubas",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecodeease.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vibecodeease.switchMode",
        "title": "Switch vibeCodeEase Mode"
      },
      {
        "command": "vibecodeease.configureGeminiKey",
        "title": "vibeCodeEase: Configure Gemini API Key"
      },
      {
        "command": "vibecodeease.applyIntervention",
        "title": "vibeCodeEase: Apply Intervention"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibecodeease-sidebar",
          "title": "vibeCodeEase",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vibecodeease-sidebar": [
        {
          "id": "vibecodeease.sidebarView",
          "name": "vibeCodeEase Settings",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vibecodeease.tabToApply",
        "key": "tab",
        "when": "editorTextFocus && !editorHasSelection && !inSnippetMode && !suggestWidgetVisible"
      }
    ],
    "configuration": {
      "title": "vibeCodeEase",
      "properties": {
        "vibecodeease.llmProvider": {
          "type": "string",
          "enum": ["gemini", "vscode-lm"],
          "default": "gemini",
          "description": "LLM Provider to use (gemini or vscode-lm)"
        },
        "vibecodeease.llmModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "LLM Model to use (e.g. gemini-2.5-flash, gpt-4o)"
        }
      }
    }
  },
  "scripts": {
    "build:ui": "npm run build --prefix webview-ui",
    "watch:ui": "npm run build --prefix webview-ui -- -w",
    "build:all": "npm run compile && npm run build:ui",
    "watch:all": "npm-run-all -p watch:esbuild watch:ui",
    "watch": "npm run watch:all",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:ui": "npm run test --prefix webview-ui",
    "test:e2e": "npm run test:e2e --prefix webview-ui",
    "test:e2e:headed": "npm run test:e2e:headed --prefix webview-ui",
    "test:all": "npm run test:ui && npm run test",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}